{
  "name": "@anoslide/dsh-client-vscode-layout",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VS Code workbench frame: explorer | multi-tab editor | AI chat, registered into the shell's root slot",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/core": "^7.22.1",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@sanity/diff-match-patch": "^3.2.0",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-bubble-menu": "^3.30.3",
    "@tiptap/extension-character-count": "^3.30.3",
    "@tiptap/extension-code": "^3.30.3",
    "@tiptap/extension-code-block-lowlight": "^3.30.3",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-dropcursor": "^3.30.3",
    "@tiptap/extension-highlight": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-mention": "^3.30.1",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-task-item": "^3.30.3",
    "@tiptap/extension-task-list": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-typography": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/extension-youtube": "^3.30.3",
    "@tiptap/markdown": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/katex": "^0.16.8",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@tiptap/extension-drag-handle": "^3.30.3",
    "@tiptap/extension-drag-handle-react": "^3.30.3",
    "jsdom": "^26.1.0"
  }
}
